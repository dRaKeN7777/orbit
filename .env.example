# ---------------------------------------------------------------------------
# Orbit configuration. Copy to `.env` and fill in what you have.
# Everything below is OPTIONAL: with an empty .env the app runs fully offline
# against sample data so you can exercise every screen before wiring keys.
# ---------------------------------------------------------------------------

# --- Server (two processes) -------------------------------------------------
# The backend serves the JSON API. The frontend serves the SPA and reverse
# proxies /api/* to the backend, so the browser only ever talks to port 3020
# and there is no CORS involved.
#
#   npm start        -> backend  on PORT          (8040)
#   npm run frontend -> frontend on FRONTEND_PORT (3020)
PORT=8040
HOST=127.0.0.1
FRONTEND_PORT=3020
FRONTEND_HOST=127.0.0.1
# Only change this if the backend runs on another host or behind a path prefix.
BACKEND_URL=http://127.0.0.1:8040
# If set, every /api/* request must send `Authorization: Bearer <ORBIT_TOKEN>`.
ORBIT_TOKEN=
DATABASE_PATH=./data/orbit.db

# --- LLM (intelligence layer) ----------------------------------------------
# DeepSeek is OpenAI-compatible. Leave the key blank to use the built-in
# deterministic offline composer (no network, no cost, still passes the
# anti-AI-smell verifier).
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
# deepseek-reasoner for analysis (research/plan), deepseek-chat for the copy.
LLM_MODEL_REASONING=deepseek-reasoner
LLM_MODEL_WRITER=deepseek-chat

# Any OpenAI-compatible endpoint works instead, e.g.:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL_REASONING=gpt-4o
#   LLM_MODEL_WRITER=gpt-4o-mini

# --- Ingestion (reading pipeline) ------------------------------------------
# LinkedIn has no official API for reading other people's personal posts, so
# ingestion runs through a permitted third-party scraper. Supports Apify-style
# actors and any generic JSON endpoint.
# sample = synthetic posts so the whole pipeline demos with no key (default)
SCRAPER_PROVIDER=sample    # sample | apify | generic | rss | none
APIFY_TOKEN=
APIFY_ACTOR_ID=harvestapi~linkedin-post-search
# For SCRAPER_PROVIDER=generic: a POST endpoint that receives {urls:[...]} and
# returns [{linkedin_url, posts:[{text,url,posted_at,reactions,comments,shares}]}]
SCRAPER_ENDPOINT=
SCRAPER_TOKEN=
# For SCRAPER_PROVIDER=rss: comma-separated feed URLs (company blogs, newsrooms)
RSS_FEEDS=

# --- Publishing (writing pipeline) -----------------------------------------
# outbox  = write .md/.json files to ./data/outbox (safe default, no account)
# linkedin = official LinkedIn REST API (requires approved app + OAuth token)
# postiz  = push drafts into a self-hosted Postiz instance via its API
PUBLISHER=outbox
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=        # e.g. urn:li:person:abc123 or urn:li:organization:456
POSTIZ_API_URL=
POSTIZ_API_KEY=
POSTIZ_INTEGRATION_ID=

# --- Website writer ---------------------------------------------------------
# static    = write Markdown files into WEBSITE_PATH (safe default)
# git       = same, then `git add/commit` in WEBSITE_PATH
# wordpress = create posts via the WordPress REST API (application password)
WEBSITE_TARGET=static
WEBSITE_PATH=./data/site
WEBSITE_BASE_URL=
GIT_COMMIT=false
GIT_AUTHOR_NAME=Orbit
GIT_AUTHOR_EMAIL=orbit@localhost

WORDPRESS_URL=
WORDPRESS_USER=
WORDPRESS_APP_PASSWORD=

# --- Automation -------------------------------------------------------------
# The three switches that make the loop autonomous.
#
# They default to ON while the destination is safe (PUBLISHER=outbox writes a
# local file, WEBSITE_TARGET=static writes a local file) so the whole loop runs
# end to end out of the box. They default to OFF as soon as you point them at a
# real destination — set them to true deliberately once you trust the output.
#
#   AUTO_SCHEDULE      pipeline queues verified drafts into posting slots
#   AUTO_PUBLISH       the publish job sends anything that is due
#   AUTO_APPLY_WEBSITE pipeline writes planned pages without review
#
# Nothing can bypass the verifier: a draft failing the gate is never scheduled
# and never published, whatever these are set to.
AUTO_SCHEDULE=false
AUTO_PUBLISH=false
AUTO_APPLY_WEBSITE=false

# Posting slots. Times are UTC. Defaults suit a UK/CH audience (mid-morning
# London, early afternoon Zurich). POSTING_DAYS: 0=Sunday..6=Saturday.
POSTING_WINDOWS=08:15,13:45
POSTING_DAYS=1,2,3,4,5
POSTS_PER_DAY=2
MIN_HOURS_BETWEEN_POSTS=6

# Enable the in-process cron worker (5-field cron, UTC).
# Set WORKER_ENABLED=false if you run `npm run worker` as a separate process.
WORKER_ENABLED=true
INGEST_CRON=0 6 * * *
DRAFT_CRON=15 6 * * *
PUBLISH_CRON=*/5 * * * *
WEBSITE_CRON=30 6 * * 1
